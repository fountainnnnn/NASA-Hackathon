{
  "name": "video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.9.45 preview",
    "check": "npx --yes hyperframes@0.9.45 check",
    "render": "npx --yes hyperframes@0.9.45 render",
    "publish": "npx --yes hyperframes@0.9.45 publish",
    "capture": "node capture.mjs",
    "build:film": "node tools/gen-scenes.mjs && node tools/build.mjs",
    "qa": "node tools/qa.mjs all",
    "render:final": "PATH=\"$PWD/.bin:$PATH\" npx hyperframes render --fps 60 --quality high --output renders/marswalk-demo.mp4",
    "gate": ".bin/ffprobe -v error -show_entries format=duration -of csv=p=0 renders/marswalk-demo.mp4"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "puppeteer-core": "^25.17.0"
  }
}